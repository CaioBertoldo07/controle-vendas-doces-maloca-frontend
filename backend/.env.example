# =============================================================================
# Doces da Maloca — backend — variáveis de ambiente (MODELO)
#
# Copie para backend/.env e ajuste. backend/.env é ignorado pelo Git.
# Este arquivo contém APENAS placeholders e valores do Docker local.
# NUNCA coloque aqui credenciais do Railway/produção.
# Guia: docs/tcc/etapa-0-ambientes-e-baseline.md
# =============================================================================

# Ambiente declarado: development | test | production
# Ferramentas de banco (seed, db push, reset de teste, backfill) e `npm run dev`
# só rodam com APP_ENV=development e banco local.
APP_ENV=development

# Banco de DESENVOLVIMENTO (MySQL do docker-compose.yml, porta 3307 no host)
DATABASE_URL="mysql://maloca:maloca_local@127.0.0.1:3307/doces_maloca_dev"

# Banco de TESTE — descartável; o nome DEVE terminar em _test e ser diferente
# do banco de desenvolvimento. Recriado com `npm run db:test:reset`.
DATABASE_URL_TEST="mysql://maloca:maloca_local@127.0.0.1:3307/doces_maloca_test"

# Autenticação (qualquer string longa e aleatória em desenvolvimento)
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# Chave usada por POST /api/vendas/auto (header x-api-key)
N8N_API_KEY=troque-por-uma-chave-de-desenvolvimento

# Porta HTTP do backend
PORT=3000

# Opcional: permite um banco de desenvolvimento fora de localhost.
# Hosts do Railway continuam bloqueados mesmo com true.
ALLOW_NON_LOCAL_DEV_DATABASE=false

# Etapa 0.2 — coleta somente leitura (npm run tcc:coleta).
# Deixe VAZIO aqui. Defina apenas no terminal, no momento da coleta,
# de preferência com um usuário MySQL que só tenha permissão de SELECT.
DATABASE_URL_COLETA=

# Senhas do MySQL do Docker local (opcionais; lidas pelo docker compose).
# Se mudar MYSQL_PASSWORD, ajuste também as URLs acima.
# MYSQL_PASSWORD=maloca_local
# MYSQL_ROOT_PASSWORD=root_local
