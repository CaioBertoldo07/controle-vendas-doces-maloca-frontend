generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String   @db.VarChar(100)
  email    String   @unique @db.VarChar(100)
  senha    String   @db.VarChar(255)
  criadoEm DateTime @default(now())
  @@map("usuarios")
}

model Cliente {
  id     Int     @id @default(autoincrement())
  nome   String  @db.VarChar(100)
  vendas Venda[]
  @@map("clientes")
}

model Sabor {
  id              Int             @id @default(autoincrement())
  nome            String          @db.VarChar(50)
  precoUnitario   Decimal         @db.Decimal(10, 2)
  ativo           Boolean         @default(true)
  rendimentoBase  Int?
  vendaSabores    VendaSabor[]
  producaoSabores ProducaoSabor[]
  receita         ReceitaItem[]
  @@map("sabores")
}

model Venda {
  id               Int          @id @default(autoincrement())
  quantidade       Int
  valor            Decimal      @db.Decimal(10, 2)
  desconto         Decimal      @default(0) @db.Decimal(10, 2)
  data             DateTime     @default(now())
  pago             Boolean      @default(false)
  dataPagamento    DateTime?
  idempotencyKey   String?      @unique @db.VarChar(100)
  clienteId        Int
  cliente          Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  sabores          VendaSabor[]
  @@index([clienteId])
  @@index([data])
  @@index([pago])
  @@map("vendas")
}

model VendaSabor {
  id         Int     @id @default(autoincrement())
  vendaId    Int
  saborId    Int
  quantidade Int
  venda      Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  sabor      Sabor   @relation(fields: [saborId], references: [id])
  @@index([vendaId])
  @@index([saborId])
  @@map("venda_sabores")
}

model MateriaPrima {
  id           Int                        @id @default(autoincrement())
  nome         String                     @db.VarChar(100)
  unidadeBase  String                     @db.VarChar(10)
  ativo        Boolean                    @default(true)
  criadoEm     DateTime                   @default(now())
  receita      ReceitaItem[]
  movimentacoes MovimentacaoMateriaPrima[]
  custos       Custo[]
  @@map("materias_primas")
}

model ReceitaItem {
  id             Int          @id @default(autoincrement())
  saborId        Int
  materiaPrimaId Int
  quantidadeBase Decimal      @db.Decimal(10, 3)
  sabor          Sabor        @relation(fields: [saborId], references: [id], onDelete: Cascade)
  materiaPrima   MateriaPrima @relation(fields: [materiaPrimaId], references: [id])
  @@index([saborId])
  @@index([materiaPrimaId])
  @@map("receita_itens")
}

model MovimentacaoMateriaPrima {
  id             Int          @id @default(autoincrement())
  materiaPrimaId Int
  tipo           String       @db.VarChar(10)
  origem         String       @db.VarChar(20)
  quantidade     Decimal      @db.Decimal(10, 3)
  data           DateTime     @default(now())
  custoId        Int?
  producaoId     Int?
  observacao     String?      @db.VarChar(255)
  materiaPrima   MateriaPrima @relation(fields: [materiaPrimaId], references: [id])
  @@index([materiaPrimaId])
  @@index([custoId])
  @@index([producaoId])
  @@map("movimentacoes_materia_prima")
}

model Custo {
  id             Int           @id @default(autoincrement())
  nome           String        @db.VarChar(100)
  categoria      String        @default("Matéria Prima") @db.VarChar(50)
  quantidade     Decimal       @db.Decimal(10, 3)
  unidade        String        @db.VarChar(20)
  valorTotal     Decimal       @db.Decimal(10, 2)
  data           DateTime      @default(now())
  observacao     String?       @db.VarChar(255)
  materiaPrimaId Int?
  materiaPrima   MateriaPrima? @relation(fields: [materiaPrimaId], references: [id])
  @@index([data])
  @@index([materiaPrimaId])
  @@map("custos")
}

model Producao {
  id         Int             @id @default(autoincrement())
  data       DateTime        @default(now())
  observacao String?         @db.VarChar(255)
  sabores    ProducaoSabor[]
  @@index([data])
  @@map("producao")
}

model ProducaoSabor {
  id         Int      @id @default(autoincrement())
  producaoId Int
  saborId    Int
  quantidade Int
  producao   Producao @relation(fields: [producaoId], references: [id], onDelete: Cascade)
  sabor      Sabor    @relation(fields: [saborId], references: [id])
  @@index([producaoId])
  @@index([saborId])
  @@map("producao_sabores")
}

// ============================================================================
// Camada SMA (Etapa 1): auditoria das execuções de agentes, cooperação,
// recomendações e ações propostas. Tabelas aditivas: nenhum modelo de domínio
// acima foi alterado. Ver docs/tcc/etapa-1-infraestrutura-multiagente.md.
// Datas: instantes técnicos em UTC (como criadoEm), não datas de negócio.
// ============================================================================

/// Uma execução de um agente (pelo HTTP, pelo Coordenador ou por mensagem).
model ExecucaoAgente {
  id            Int              @id @default(autoincrement())
  agente        String           @db.VarChar(50)
  tipoExecucao  String           @db.VarChar(50) // ex.: PING, DIAGNOSTICO, PERGUNTA
  gatilho       String           @db.VarChar(20) // HTTP | MENSAGEM | INTERNO (CRON/EVENTO no futuro)
  status        String           @db.VarChar(20) // EM_ANDAMENTO | SUCESSO | FALHA
  iniciadaEm    DateTime         @default(now())
  finalizadaEm  DateTime?
  duracaoMs     Int?
  entrada       Json?
  saida         Json?
  erro          String?          @db.Text
  metadados     Json?
  execucaoPaiId Int?
  execucaoPai   ExecucaoAgente?  @relation("Delegacao", fields: [execucaoPaiId], references: [id], onDelete: SetNull)
  filhas        ExecucaoAgente[] @relation("Delegacao")
  chamadasTool  ChamadaTool[]
  mensagens     MensagemAgente[] @relation("MensagensEnviadas")
  recebidas     MensagemAgente[] @relation("MensagensRecebidas")
  recomendacoes Recomendacao[]
  acoes         AcaoProposta[]

  @@index([agente])
  @@index([status])
  @@index([iniciadaEm])
  @@index([execucaoPaiId])
  @@map("execucoes_agente")
}

/// Uma chamada de tool dentro de uma execução (pelo agente ou pelo LLM).
model ChamadaTool {
  id         Int            @id @default(autoincrement())
  execucaoId Int
  execucao   ExecucaoAgente @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  tool       String         @db.VarChar(80)
  origem     String         @db.VarChar(20) // AGENTE | LLM
  entrada    Json?
  ok         Boolean
  saida      Json?
  erro       String?        @db.Text
  duracaoMs  Int
  criadaEm   DateTime       @default(now())

  @@index([execucaoId])
  @@index([tool])
  @@map("chamadas_tool")
}

/// Mensagem explícita entre agentes (cooperação).
model MensagemAgente {
  id                Int             @id @default(autoincrement())
  execucaoId        Int
  execucao          ExecucaoAgente  @relation("MensagensEnviadas", fields: [execucaoId], references: [id], onDelete: Cascade)
  execucaoDestinoId Int?
  execucaoDestino   ExecucaoAgente? @relation("MensagensRecebidas", fields: [execucaoDestinoId], references: [id], onDelete: SetNull)
  agenteOrigem      String          @db.VarChar(50)
  agenteDestino     String          @db.VarChar(50)
  tipo              String          @db.VarChar(50)
  conteudo          Json?
  status            String          @db.VarChar(20) // ENVIADA | RESPONDIDA | FALHA
  resposta          Json?
  criadaEm          DateTime        @default(now())

  @@index([execucaoId])
  @@index([agenteOrigem, agenteDestino])
  @@map("mensagens_agente")
}

/// Recomendação produzida por um agente para o gestor (não altera dados).
model Recomendacao {
  id          Int             @id @default(autoincrement())
  agente      String          @db.VarChar(50)
  execucaoId  Int?
  execucao    ExecucaoAgente? @relation(fields: [execucaoId], references: [id], onDelete: SetNull)
  tipo        String          @db.VarChar(50)
  titulo      String          @db.VarChar(200)
  descricao   String          @db.Text
  prioridade  String          @db.VarChar(10) // BAIXA | MEDIA | ALTA
  status      String          @default("ABERTA") @db.VarChar(20) // ABERTA | RESOLVIDA | IGNORADA (Etapa 2; dedup por dados.controle.chave)
  dados       Json?
  criadaEm    DateTime        @default(now())
  resolvidaEm DateTime?

  @@index([status])
  @@index([agente])
  @@map("recomendacoes")
}

/// Única forma de um agente pedir uma escrita: nasce PENDENTE e só um
/// executor determinístico a executa, depois da aprovação do gestor.
model AcaoProposta {
  id              Int             @id @default(autoincrement())
  tipo            String          @db.VarChar(50) // allowlist em src/agents/acoes/contratos.js
  payload         Json
  descricao       String          @db.Text
  status          String          @default("PENDENTE") @db.VarChar(20) // PENDENTE | APROVADA | REJEITADA | EXECUTANDO | EXECUTADA | FALHA
  criadaPorAgente String          @db.VarChar(50)
  execucaoId      Int?
  execucao        ExecucaoAgente? @relation(fields: [execucaoId], references: [id], onDelete: SetNull)
  criadaEm        DateTime        @default(now())
  aprovadaEm      DateTime?
  rejeitadaEm     DateTime?
  motivoRejeicao  String?         @db.VarChar(500)
  executadaEm     DateTime?
  resultado       Json?
  erro            String?         @db.Text

  @@index([status])
  @@index([criadaPorAgente])
  @@map("acoes_propostas")
}
