{
  "name": "doce-maloca-backend",
  "version": "1.0.0",
  "description": "Backend do sistema Doces da Maloca",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ambiente/verificarAmbiente.js desenvolvimento && nodemon src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "ambiente:verificar": "node scripts/ambiente/verificarAmbiente.js desenvolvimento",
    "db:dev:push": "node scripts/ambiente/prisma.js desenvolvimento db push",
    "db:dev:seed": "node prisma/seed.js",
    "db:test:reset": "node scripts/ambiente/prisma.js teste db push --force-reset --skip-generate",
    "test:guardas": "node --test \"scripts/**/*.test.js\"",
    "tcc:coleta": "node scripts/tcc/coletarDadosReadOnly.js",
    "tcc:restaurar": "node scripts/tcc/restaurarBackupLocal.js",
    "backfill:pagamentos": "node scripts/marcarVendasAntigasPagas.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
